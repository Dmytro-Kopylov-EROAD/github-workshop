---
// Defines the shared document structure and applies saved accessibility preferences before rendering.
import Header from "../components/Header.astro"
import "../styles/global.css"

interface Props {
  title?: string;
}

const { title = "Tailspin Toys" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <script is:inline>
            (() => {
                const storageKey = 'tailspin-high-contrast';

                try {
                    if (localStorage.getItem(storageKey) === 'true') {
                        document.documentElement.classList.add('high-contrast');
                    }
                } catch (error) {
                    console.warn('Unable to read the saved contrast preference.', error);
                }
            })();
        </script>
        <!-- Preconnect to improve font loading -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </head>
    <body class="min-h-screen bg-slate-900 text-white transition-colors duration-300 motion-reduce:transition-none m-0 w-full h-full font-sans high-contrast:bg-black high-contrast:text-white">
        <a
            href="#main-content"
            data-testid="skip-to-content"
            class="fixed left-4 top-4 z-50 -translate-y-24 rounded bg-white px-4 py-3 font-semibold text-black focus:translate-y-0 focus:outline-none focus:ring-4 focus:ring-blue-400 high-contrast:focus:ring-yellow-300 motion-reduce:transition-none"
        >
            Skip to main content
        </a>
        <Header />
        <main id="main-content" class="container mx-auto py-6 h-full max-w-7xl" tabindex="-1">
            <div class="px-4 sm:px-6 lg:px-8">
                <slot />
            </div>
        </main>
    </body>
</html>

<style is:global>
    :root {
        --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    }
    
    html {
        font-family: var(--font-sans);
        scroll-behavior: smooth;
    }
    
    body {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
</style>
