---
// Accessible checkbox-based filter controls for narrowing the games grid by
// category and/or publisher. Filtering itself is applied client-side by the
// scoped <script> in `src/pages/index.astro`, which reads the checkbox state
// rendered here.
import type { Category, Publisher } from '../types/game';

interface Props {
    categories: Category[];
    publishers: Publisher[];
}

const { categories, publishers } = Astro.props;
---

<div
    data-testid="game-filters"
    class="mb-8 p-6 bg-slate-800/60 backdrop-blur-sm rounded-xl border border-slate-700/50"
>
    <div class="flex items-start justify-between gap-4 mb-4">
        <h2 class="text-lg font-medium text-slate-100">Filter games</h2>
        <button
            type="button"
            id="clear-filters-button"
            data-testid="clear-filters-button"
            class="text-sm font-medium text-blue-400 hover:text-blue-300 focus:ring-2 focus:ring-blue-500 focus:outline-none rounded px-2 py-1 transition-colors"
        >
            Clear filters
        </button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <fieldset data-testid="category-filter-group">
            <legend class="text-sm font-semibold text-slate-300 mb-2">Category</legend>
            <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                    <label class="inline-flex items-center gap-2 text-sm text-slate-200 cursor-pointer">
                        <input
                            type="checkbox"
                            class="filter-checkbox rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                            data-filter-type="category"
                            data-filter-id={category.id}
                            data-testid={`category-filter-checkbox-${category.id}`}
                        />
                        {category.name}
                    </label>
                ))}
            </div>
        </fieldset>

        <fieldset data-testid="publisher-filter-group">
            <legend class="text-sm font-semibold text-slate-300 mb-2">Publisher</legend>
            <div class="flex flex-wrap gap-3">
                {publishers.map((publisher) => (
                    <label class="inline-flex items-center gap-2 text-sm text-slate-200 cursor-pointer">
                        <input
                            type="checkbox"
                            class="filter-checkbox rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                            data-filter-type="publisher"
                            data-filter-id={publisher.id}
                            data-testid={`publisher-filter-checkbox-${publisher.id}`}
                        />
                        {publisher.name}
                    </label>
                ))}
            </div>
        </fieldset>
    </div>
</div>
